generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id              String   @id @default(uuid())
  username        String?  @unique
  email           String   @unique
  name            String
  role            String
  passwordHash    String?
  allowGoogle     Boolean  @default(true)
  isActive        Boolean  @default(true)
  twoFactorSecret String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([email])
  @@index([role])
  @@index([isActive])
  @@map("users")
}

model Customer {
  id           String   @id @default(uuid())
  name         String
  contact      String?
  identifier   String?
  customerType String
  lastPurchase String   @default("Sin compras")
  purchases    Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sales        Sale[]

  @@index([name])
  @@index([identifier])
  @@index([customerType])
  @@index([isActive])
  @@map("customers")
}

model Supplier {
  id             String   @id @default(uuid())
  name           String
  identifier     String?
  contactName    String?
  phone          String?
  email          String?
  lastPurchase   String   @default("Sin compras")
  totalPurchases Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  purchases      Purchase[]

  @@index([name])
  @@index([identifier])
  @@index([isActive])
  @@map("suppliers")
}

model StockValorizado {
  index       Int       @id @default(autoincrement())
  codigo      Int?
  descrip     String?
  displayName String?
  searchName  String?
  stock       Int?
  prventa     Int?
  sbtotal     Int?
  prcosto     Float?
  sbtot       Int?
  fecha       DateTime?

  @@index([codigo])
  @@index([searchName])
  @@map("stockvalorizado")
}

model Ventas {
  index    Int     @id @default(autoincrement())
  codint   String?
  descrip  String?
  cantidad Int?
  stock    Int?

  ventas01 Int?
  ventas02 Int?
  ventas03 Int?
  ventas04 Int?
  ventas05 Int?
  ventas06 Int?
  ventas07 Int?
  ventas08 Int?
  ventas09 Int?
  ventas10 Int?
  ventas11 Int?
  ventas12 Int?
  ventas13 Int?

  costoven Int?

  stk01    Int?
  stk02    Int?
  stk03    Int?
  stk04    Int?
  stk05    Int?
  stk06    Int?
  stk07    Int?
  stk08    Int?
  stk09    Int?
  stk10    Int?
  stk11    Int?
  stk12    Int?

  familia  String?
  prcosto  Float?

  @@index([codint])
  @@index([familia])
  @@map("ventas")
}

model Purchase {
  id             String         @id @default(uuid())
  date           DateTime
  supplierId     String?
  supplierName   String
  documentNumber String
  createdBy      String?
  createdByRole  String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  supplier       Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  items          PurchaseItem[]

  @@unique([documentNumber])
  @@index([date])
  @@index([supplierId])
  @@index([supplierName])
  @@map("purchases")
}

model PurchaseItem {
  id          String   @id @default(uuid())
  purchaseId  String
  codigo      String
  productName String?
  quantity    Int
  unitPrice   Float?
  totalPrice  Float?
  stockAfter  Int?
  createdAt   DateTime @default(now())

  purchase    Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([purchaseId])
  @@index([codigo])
  @@map("purchase_items")
}

model Sale {
  id                 String     @id @default(uuid())
  date               DateTime
  customerId          String?
  customerName        String
  customerType        String
  customerIdentifier  String?
  documentType        String
  documentNumber      String
  createdBy           String?
  createdByRole       String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  customer            Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items               SaleItem[]

  @@unique([documentNumber])
  @@index([date])
  @@index([customerId])
  @@index([customerName])
  @@index([documentType])
  @@map("sales")
}

model SaleItem {
  id          String   @id @default(uuid())
  saleId      String
  codigo      String
  productName String?
  quantity    Int
  unitPrice   Float?
  totalPrice  Float?
  stockAfter  Int?
  createdAt   DateTime @default(now())

  sale        Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@index([codigo])
  @@map("sale_items")
}

model InventoryMovement {
  id          Int      @id @default(autoincrement())
  codigo      String
  productName String?
  type        String
  quantity    Int
  unitPrice   Float?
  totalPrice  Float?
  stockAfter  Int?
  reason      String?
  user        String?
  detail      String?
  createdAt   DateTime @default(now())

  @@index([codigo])
  @@index([type])
  @@index([createdAt])
  @@map("inventory_movements")
}

model ChatbotAudit {
  id           Int      @id @default(autoincrement())
  userId       String
  username     String
  role         String
  query        String
  responseType String
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([username])
  @@index([role])
  @@index([createdAt])
  @@map("chatbot_audit")
}

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model StockValorizado {
  index       Int       @id @default(autoincrement())
  codigo      Int?
  descrip     String?

  // Nombre limpio para mostrar en el frontend
  displayName String?

  // Nombre normalizado para búsquedas y chatbot
  searchName  String?

  stock       Int?
  prventa     Int?
  sbtotal     Int?
  prcosto     Float?
  sbtot       Int?
  fecha       DateTime?

  @@map("stockvalorizado")
}

model Ventas {
  index    Int     @id @default(autoincrement())
  codint   String?
  descrip  String?
  cantidad Int?
  stock    Int?
  ventas01 Int?
  ventas02 Int?
  ventas03 Int?
  ventas04 Int?
  ventas05 Int?
  ventas06 Int?
  ventas07 Int?
  ventas08 Int?
  ventas09 Int?
  ventas10 Int?
  ventas11 Int?
  ventas12 Int?
  ventas13 Int?
  costoven Int?
  stk01    Int?
  stk02    Int?
  stk03    Int?
  stk04    Int?
  stk05    Int?
  stk06    Int?
  stk07    Int?
  stk08    Int?
  stk09    Int?
  stk10    Int?
  stk11    Int?
  stk12    Int?
  familia  String?
  prcosto  Float?

  @@map("ventas")
}

model InventoryMovement {
  id          Int      @id @default(autoincrement())

  // Código del producto afectado
  codigo      String

  // Nombre del producto al momento del movimiento
  productName String?

  // Tipo de movimiento: ENTRADA, SALIDA, AJUSTE
  type        String

  // Cantidad movida
  quantity    Int

  // Precio unitario usado en el movimiento
  unitPrice   Float?

  // Total del movimiento
  totalPrice  Float?

  // Stock resultante después del movimiento
  stockAfter  Int?

  // Motivo o explicación del movimiento
  reason      String?

  // Usuario que ejecutó el movimiento
  user        String?

  // Detalle libre del movimiento
  detail      String?

  createdAt   DateTime @default(now())

  @@index([codigo])
  @@index([type])
  @@index([createdAt])
  @@map("inventory_movements")
}

model ChatbotAudit {
  id           Int      @id @default(autoincrement())
  userId       String
  username     String
  role         String
  query        String
  responseType String
  createdAt    DateTime @default(now())

  @@map("chatbot_audit")
}